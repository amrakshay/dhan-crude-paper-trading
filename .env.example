# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; .env.example is not.
# ---------------------------------------------------------------------------

# --- Login (single hardcoded user; there is no user table) -----------------
APP_USERNAME=trader
APP_PASSWORD=change-me
# Signing key for the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank, a random key is generated per process and every restart logs
# you out.
APP_JWT_SECRET=

# Key used to encrypt secret settings at rest -- currently the Dhan access
# token saved on the Settings page. Generate one the same way.
#
# If this is blank, APP_JWT_SECRET is used instead. If BOTH are blank the app
# REFUSES to store an access token, rather than encrypt it under a key that
# changes every restart and could never be read back.
#
# Prefer setting this: rotating APP_JWT_SECRET then does not destroy the
# stored token.
APP_ENCRYPTION_KEY=

# --- Dhan (DhanHQ v2) MARKET DATA credentials ------------------------------
# These are used for the WebSocket feed, the option chain endpoint and the
# instrument master CSV. This application contains no order-placement code path
# and never calls a trading endpoint.
#
# NOTE: these three are only the FALLBACK. Anything saved on the Settings page
# in the UI is stored in the database and takes priority over them. The Settings
# page also validates a token against Dhan and shows its time to expiry.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Set to false once the two values above are filled in.
# true  = NO upstream connection; prices are generated locally (clearly marked
#         SYNTHETIC in the UI). Useful outside MCX hours (09:00-23:30 IST).
# false = real Dhan market data.
DHAN_SYNTHETIC_FEED=true

# --- Database --------------------------------------------------------------
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./data/paper_trading.db
# MySQL -- change this one line, then run `alembic upgrade head`:
# DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/crude_paper?charset=utf8mb4

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
