.venv/
__pycache__/
*.pyc

# The rebuilt universe: a 960 MB SQLite database of 7.25M daily bars and the
# cached 35 MB instrument master. Both are FETCHED, not authored -- rebuild
# them with `scripts/run_all.py --with-data` (~50 min, needs a live Dhan
# token). The IPO calendar is kept, because it is 550 rows, it is the only
# thing here that cannot be re-derived from Dhan, and its source paywalls
# history beyond the current year.
data/listings.db
data/master.csv

# Per-signal dumps, regenerated by every run. The summary .txt files and the
# dashboard ARE committed -- they are what the write-ups quote.
out/rows_*.json
out/signals_*.json
out/build_universe.log
